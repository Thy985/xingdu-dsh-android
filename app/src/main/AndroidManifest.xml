<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <application android:theme="@style/AppTheme" android:label="星渡" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/backup_rules" android:usesCleartextTraffic="true" android:networkSecurityConfig="@xml/network_security_config">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
        android:windowSoftInputMode="adjustResize">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity>
    <activity android:name=".RemoteActivity" android:exported="false" android:process=":remote"
        android:windowSoftInputMode="adjustResize" />
    <provider android:name=".ScreenPrivacyProvider"
        android:authorities="${applicationId}.screen-privacy" android:exported="false" />
    <service android:name=".DshService" android:exported="false" android:stopWithTask="false" />
  </application>
</manifest>
